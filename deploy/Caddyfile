# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically.
# WebSocket upgrades (Socket.IO) are proxied transparently.
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy caravan:3000 {
		# While the game container restarts (deployments), hold requests instead of failing them.
		lb_try_duration 20s
		lb_try_interval 500ms
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
